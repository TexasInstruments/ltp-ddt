# @name EMMC Write/Read Performance test fs: ext3
# @requires mmc_host
# @desc format emmc device first and then mount it and do read write perf test
# @setup_requires emmc

EMMC_L_PERF_EXT3 source "common.sh"; install_modules.sh "emmc"; blk_device_filesystem_perf_test.sh -f ext3 -s 100 -B "102400 262144 524288 1048576 5242880" -d "emmc"
EMMC_L_PERF_EXT3_SYNC source "common.sh"; install_modules.sh "emmc"; blk_device_filesystem_perf_test.sh -f ext3 -s 100 -o 'sync' -B "102400 262144 524288 1048576 5242880" -d "emmc"
