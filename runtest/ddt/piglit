# @name Piglit conformance tests
# @desc Run OpenGLES, Vulkan, and OpenCL conformance tests
# @requires graphics

PIGLIT_L_ARGB_ALL source 'common.sh'; swapfile_create; piglit run deqp_egl deqp_gles31 deqp_vk results -t ".*argb.*"; output=$(piglit summary console results -p); if echo "${output}" | grep -q 'failed$'; then die "${output}"; fi; swapfile_destroy;

