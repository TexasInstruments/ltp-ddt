# @name Memtester plus standby/resume
# @desc Test memory using memtester application while doing power standby/resume operations
# @requires power_mgr
# @setup_requires

POWERMGR_XL_STRESS_ALLPATTERNS_MEMTEST10p_STANDBY source 'functions.sh'; trap on_exit EXIT; MTLOG=/tmp/memtest_standby.log; run_memtest 10 1 > $MTLOG 2>&1 & MT=$!; i=0; while kill -0 $MT 2>/dev/null; do i=`expr $i + 1`; test_print_trc "Outer Loop: $i"; suspend -i 1 -p "standby" -a 20; test_print_trc "memtester progress: log_bytes=`wc -c < $MTLOG`"; grep -q FAILURE $MTLOG && die "memtester reported FAILURE"; done; wait $MT; rc=$?; [ $rc -eq 0 ] || die "memtester exited with rc=$rc"; grep -q FAILURE $MTLOG && die "memtester reported FAILURE"; [ $i -gt 0 ] || die "memtester finished before any standby cycle"; test_print_trc "memtester completed all patterns across $i standby cycles, no failures"
POWERMGR_XL_STRESS_ALLPATTERNS_MEMTEST50p_STANDBY source 'functions.sh'; trap on_exit EXIT; MTLOG=/tmp/memtest_standby.log; run_memtest 50 1 > $MTLOG 2>&1 & MT=$!; i=0; while kill -0 $MT 2>/dev/null; do i=`expr $i + 1`; test_print_trc "Outer Loop: $i"; suspend -i 1 -p "standby" -a 20; test_print_trc "memtester progress: log_bytes=`wc -c < $MTLOG`"; grep -q FAILURE $MTLOG && die "memtester reported FAILURE"; done; wait $MT; rc=$?; [ $rc -eq 0 ] || die "memtester exited with rc=$rc"; grep -q FAILURE $MTLOG && die "memtester reported FAILURE"; [ $i -gt 0 ] || die "memtester finished before any standby cycle"; test_print_trc "memtester completed all patterns across $i standby cycles, no failures"

POWERMGR_S_FUNC_MEMTEST10p_STANDBY source 'functions.sh'; MTLOG=/tmp/memtest_standby.log; start_memtest 10 > $MTLOG 2>&1; MT=$!; for i in `seq 10`; do test_print_trc "Outer Loop: $i"; suspend -i 1 -p "standby"; test_print_trc "memtester progress: log_bytes=`wc -c < $MTLOG`"; kill -0 $MT 2>/dev/null || { wait $MT; die "memtester exited early, rc=$?"; }; grep -q FAILURE $MTLOG && die "memtester reported FAILURE"; done; kill_memtest; grep -q FAILURE $MTLOG && die "memtester reported FAILURE"; test_print_trc "memtester ran through 10 standby cycles, no failures"
