# V4L2 Compliance Cases

TIENC_S_FUNC_V4L2_COMPLIANCE source 'ti_codecs.sh'; insert_video_modules; DEV=$(for f in /sys/class/video4linux/video*/name; do grep -qi "encoder" "$f" 2>/dev/null && echo "/dev/$(basename $(dirname $f))"; done | head -1); [ -n "$DEV" ] || die "Could not find Wave5 encoder device"; Log=$(mktemp); v4l2-compliance -d "$DEV" 2>&1 | tee "$Log"; grep "Failed: 0" "$Log" || die "v4l2-compliance reported failures for encoder $DEV"; rm -f "$Log"
